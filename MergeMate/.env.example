# MergeMate Environment Variables Configuration
# Copy this file to .env and adjust if necessary

# Local MongoDB Community Server URI (default on Windows localhost, no password required)
MONGO_URI=mongodb://127.0.0.1:27017/

# Database Name
MONGO_DBNAME=mergemate_db

# Flask Secret Key for session and flash messages
SECRET_KEY=mergemate-college-dbms-secret-key-2026

# Flask Debug Mode
FLASK_DEBUG=True
